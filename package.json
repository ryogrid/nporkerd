{
  "name": "nporkerd",
  "description": "Online multiplayer Texas Hold'em poker on Convex",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:convex": "npx convex dev",
    "build": "vite build",
    "deploy": "npx @convex-dev/static-hosting deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p convex/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.2.1",
    "convex": "^1.49.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "convex-test": "^0.0.67",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
